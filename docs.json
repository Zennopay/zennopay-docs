{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Zennopay",
  "colors": {
    "primary": "#444CE7",
    "light": "#8891F5",
    "dark": "#3A41D8"
  },
  "favicon": "/images/favicon.svg",
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Zennopay Docs",
      "og:title": "Zennopay Docs — QR Payments and Platform Payouts",
      "og:description": "Integrate cross-border QR Payments with a native PaymentSheet or send asynchronous bank payouts with the Platform Payouts API.",
      "og:image": "https://docs.zennopay.com/images/og-image.png",
      "og:type": "website",
      "twitter:card": "summary_large_image",
      "twitter:title": "Zennopay Docs — QR Payments and Platform Payouts",
      "twitter:description": "Developer documentation for Zennopay QR Payments and Platform Payouts.",
      "twitter:image": "https://docs.zennopay.com/images/og-image.png"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "how-zennopay-works"
            ]
          },
          {
            "group": "QR Payments",
            "pages": [
              "qr-payments/overview",
              "quickstart",
              "concepts/funds-flow",
              "payments/overview",
              "payments/session-endpoint",
              "payments/ios",
              "payments/android",
              "payments/flutter",
              "payments/react-native",
              "payments/testing",
              "payments/reopen-receipt"
            ]
          },
          {
            "group": "Platform Payouts",
            "pages": [
              "platform-payouts/overview",
              "platform-payouts/quickstart",
              "platform-payouts/testing"
            ]
          },
          {
            "group": "Shared foundations",
            "pages": [
              "authentication",
              "concepts/settlement"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api-reference/overview",
              "api-reference/environments",
              "api-reference/playground",
              {
                "group": "QR Payments",
                "pages": [
                  "concepts/corridors",
                  "fundamentals/limits",
                  "api-reference/payment-intents/create",
                  "api-reference/payment-intents/session",
                  "api-reference/payment-intents/scan",
                  "api-reference/payment-intents/confirm",
                  "api-reference/payment-intents/get",
                  "api-reference/payment-intents/receipt-token",
                  "api-reference/payment-intents/receipt",
                  "api-reference/webhooks"
                ]
              },
              {
                "group": "Platform Payouts",
                "pages": [
                  "platform-payouts/beneficiaries",
                  "platform-payouts/payouts",
                  "platform-payouts/webhooks"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/advanced/self-signed-sessions",
      "destination": "/authentication"
    },
    {
      "source": "/api-reference/jwt-inspector",
      "destination": "/authentication"
    },
    {
      "source": "/sdks/overview",
      "destination": "/payments/overview"
    },
    {
      "source": "/sdks/session-endpoint",
      "destination": "/payments/session-endpoint"
    },
    {
      "source": "/sdks/ios",
      "destination": "/payments/ios"
    },
    {
      "source": "/sdks/android",
      "destination": "/payments/android"
    },
    {
      "source": "/sdks/flutter",
      "destination": "/payments/flutter"
    },
    {
      "source": "/sdks/react-native",
      "destination": "/payments/react-native"
    }
  ],
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "api": {
    "openapi": "openapi.json"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "background": {
    "decoration": "windows",
    "color": {
      "light": "#ffffff",
      "dark": "#091422"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "mailto:support@zennopay.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://console.zennopay.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://zennopay.com"
    }
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk"
    },
    "body": {
      "family": "Inter"
    }
  }
}
